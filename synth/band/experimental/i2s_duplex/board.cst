// Pro Dock J23; same signal mapping as the reviewed 2026-10-28 wiring table.
IO_LOC "clk" P16;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "key_play_n" K16;
IO_LOC "key_stop_n" F15;
IO_LOC "key_panic_n" G15;
IO_PORT "key_play_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "key_stop_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "key_panic_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "i2s_bck" W21;
IO_LOC "i2s_ws" Y21;
IO_LOC "i2s_sd" P21;
IO_LOC "mic_sd" U17;
// Dedicated microphone clocks: J23-37 and J23-38 (not DAC pins).
IO_LOC "mic_bck" V19;
IO_LOC "mic_ws" W19;
IO_PORT "mic_bck" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_PORT "mic_ws" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_PORT "i2s_bck" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_PORT "i2s_ws" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_PORT "i2s_sd" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
IO_PORT "mic_sd" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "PA_EN" H17;
IO_PORT "PA_EN" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE;
